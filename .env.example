# Copie para .env.local e preencha.

# URL pública do site (metadados, sitemap, JSON-LD). Ex.: https://www.seubuffet.com.br
# Sem ela, no Netlify/Vercel o site usa o domínio de produção da plataforma.
NEXT_PUBLIC_SITE_URL=

# ID do contêiner do Google Tag Manager (ex.: GTM-XXXXXXX). Vazio = GTM desligado.
NEXT_PUBLIC_GTM_ID=
